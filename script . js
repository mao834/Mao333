body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #a8e0e8; /* สีฟ้าคล้ายน้ำทะเล */
}

#whale {
    width: 60px;
    height: 60px;
    background-color: #3a6b8b; /* สีของปลาวาฬ */
    clip-path: polygon(20% 0%, 80% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.5s ease-out; /* ทำให้เคลื่อนที่นุ่มนวล */
}